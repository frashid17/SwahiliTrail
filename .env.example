# Clerk (filled by `clerk init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Admin console (/admin) — comma-separated Clerk primary emails (fail closed if empty)
# ADMIN_EMAILS=you@example.com,ops@example.com

# Google AI (Gemini) — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Fast default (Gemini 3.x). Uses thinkingLevel=MINIMAL — do not set thinkingBudget.
# GOOGLE_AI_MODEL=gemini-3.5-flash-lite

# Google Places API (New) — live reviews on /explore/[id]
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Ticketmaster Discovery — live Kenya events (music, sports, arts, …)
# https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# HustleSasa marketplace is scraped from https://www.hustle.events (no key).
# Google Places (above) also feeds venue discovery on /events.

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (server-only) — required so My Trips + Guide sync across devices
# Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — Trail Plus checkout (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=
# Optional public key (not required for server redirect checkout)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Amount in smallest unit (default 52000 = 520 KES ≈ $4)
PAYSTACK_TRAIL_PLUS_AMOUNT=52000
PAYSTACK_CURRENCY=KES
# Optional: Paystack Plan code (PLN_xxx). Used ONLY after a reusable card
# charge for auto-renew. M-Pesa stays one-time 30-day access (pay again to renew).
# PAYSTACK_PLAN_CODE=
# Public site URL for Paystack callbacks (required in production).
# Must be https:// (not http) or Clerk sessions drop after checkout.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
