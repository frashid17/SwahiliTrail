# Clerk (filled by `clerk init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google AI (Gemini) — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Google Places API (New) — live reviews on /explore/[id]
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Ticketmaster Discovery — live Kenya events near Mombasa
# https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (server-only) — required so My Trips + Guide sync across devices
# Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
